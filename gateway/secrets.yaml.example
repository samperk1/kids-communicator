# Copy to secrets.yaml (in Home Assistant: /config/esphome/secrets.yaml — you
# may already have one; add these lines to it) and fill in your own values.
# secrets.yaml is never committed: it is in .gitignore.

wifi_ssid: your-wifi-name
wifi_password: your-wifi-password

# 32 random bytes, base64. Generate one with:
#   head -c 32 /dev/urandom | base64
# or let the ESPHome dashboard generate it when you create the device.
gateway_api_key: REPLACE-WITH-32-RANDOM-BYTES-BASE64=

# Any password; used when updating the gateway over WiFi.
ota_password: choose-a-password

# 🚨 The same 8-digit fleet code you typed into every handset. This IS the
# family's secret: anyone holding it can pair with your handsets.
comm_fleet_code: "00000000"
